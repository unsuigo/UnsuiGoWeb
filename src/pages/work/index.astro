---
import { getCollection } from 'astro:content';
import Footer from '@/components/navigation/Footer.astro';
import ProjectVisual from '@/components/ui/ProjectVisual.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);
const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Work — UnsuiGo Unity / XR Development"
  description="Finished Meta Quest projects and Unity, XR, AR and interactive-systems prototypes by UnsuiGo."
>
  <header class="page-hero page-hero--work">
    <p class="eyebrow">Unity / XR work</p>
    <h1>Working builds.<br /><em>Technical range.</em></h1>
    <p class="page-hero__intro">Finished Quest projects, interaction prototypes and technical Unity systems—clearly labeled by their current status.</p>
  </header>

  <section class="work-index section-pad" aria-label="Project archive">
    {projects.map((project, index) => (
      <article>
        <a href={`${base}work/${project.data.slug}/`}>
          <ProjectVisual
            visual={project.data.visual}
            tone={project.data.tone}
            title={project.data.title}
            index={`UG/${String(index + 1).padStart(2, '0')}`}
            media={project.data.heroMedia}
            placeholderKind={project.data.placeholderKind}
            mediaAspect={project.data.mediaAspect}
          />
          <div class="work-index__meta">
            <span>0{index + 1}</span>
            <h2>{project.data.title}</h2>
            <p><strong>{project.data.type}</strong><br />{project.data.description}</p>
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      </article>
    ))}
  </section>
  <Footer />
</BaseLayout>
