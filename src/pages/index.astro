---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import CommercialDevelopment from '@/sections/CommercialDevelopment/CommercialDevelopment.astro';
import Contact from '@/sections/Contact/Contact.astro';
import Hero from '@/sections/Hero/Hero.astro';
import Philosophy from '@/sections/Philosophy/Philosophy.astro';
import Services from '@/sections/Services/Services.astro';
import TechnicalWork from '@/sections/TechnicalWork/TechnicalWork.astro';
import Work from '@/sections/Work/Work.astro';
import Footer from '@/components/navigation/Footer.astro';
import Reveal from '@/components/effects/Reveal.astro';

const projects = await getCollection('projects');
const selectedProjects = projects
  .filter(({ data }) => data.section === 'selected' && data.featured)
  .sort((a, b) => a.data.order - b.data.order);
const technicalProjects = projects
  .filter(({ data }) => data.section === 'technical')
  .sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services', ({ data }) => data.featured))
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout>
  <Hero />
  <Work projects={selectedProjects} />
  <TechnicalWork projects={technicalProjects} />
  <CommercialDevelopment />
  <Services services={services} />
  <Philosophy />
  <Contact />
  <Footer />
  <Reveal />
</BaseLayout>
