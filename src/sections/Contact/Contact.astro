---
import { contact, siteSettings } from '@/data/site';

const phoneHref = siteSettings.contactPhone?.replace(/[^\d+]/g, '');
const [location, remoteAvailability] = siteSettings.location.split(' / ');
---

<section class="contact-section section-pad" id="contact" aria-labelledby="contact-title">
  <p class="eyebrow">07 / {contact.eyebrow}</p>
  <div class="contact-section__body" data-reveal>
    <h2 id="contact-title">{contact.title}</h2>
    {siteSettings.contactEmail ? (
      <a class="contact-section__primary" href={`mailto:${siteSettings.contactEmail}`}>
        <span><small>Email</small>{siteSettings.contactEmail}</span>
        <span aria-hidden="true">↗</span>
      </a>
    ) : (
      <span class="contact-section__status" aria-label={siteSettings.contactLabel}>
        <span>{contact.linkLabel}</span>
        <span aria-hidden="true">+</span>
      </span>
    )}
  </div>
  <div class="contact-section__note">
    <p>{contact.responseNote}</p>
    <div class="contact-section__methods">
      {siteSettings.social.map((item) => (
        <a class="contact-section__method" href={item.href} target="_blank" rel="noopener noreferrer">
          <span>{item.label}</span>
          <strong>{item.name} ↗</strong>
        </a>
      ))}
      {siteSettings.contactPhone && (
        <a class="contact-section__method" href={`tel:${phoneHref}`}>
          <span>Phone</span>
          <strong>{siteSettings.contactPhone}</strong>
        </a>
      )}
      <p>{location}<br />{remoteAvailability}</p>
    </div>
  </div>
</section>
