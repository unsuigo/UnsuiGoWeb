---
import { about } from '@/data/site';
---

<section class="philosophy-section section-pad" id="about" aria-labelledby="philosophy-title">
  <div class="philosophy-section__marker" aria-hidden="true">
    <span>Solo studio</span><span>→</span><span>Direct work</span>
  </div>
  <div class="philosophy-section__content" data-reveal>
    <p class="eyebrow">06 / {about.label}</p>
    <h2 id="philosophy-title">{about.title}</h2>
    <p>{about.body}</p>
    <p class="philosophy-section__availability">{about.availability}</p>
    <p class="philosophy-section__technologies">{about.technologies}</p>
  </div>
</section>
