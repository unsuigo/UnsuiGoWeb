---
import { philosophy } from '@/data/site';
---

<section class="philosophy-section section-pad" id="studio" aria-labelledby="philosophy-title">
  <div class="philosophy-section__marker" aria-hidden="true">
    <span>Idea</span><span>→</span><span>Experience</span>
  </div>
  <div class="philosophy-section__content" data-reveal>
    <p class="eyebrow">05 / {philosophy.label}</p>
    <h2 id="philosophy-title">{philosophy.title}</h2>
    <p>{philosophy.body}</p>
  </div>
</section>
