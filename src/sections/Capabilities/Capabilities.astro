---
import SectionHeading from '@/components/ui/SectionHeading.astro';
import { capabilities } from '@/data/site';
---

<section class="capabilities-section section-pad" aria-labelledby="capabilities-title">
  <SectionHeading index="06" label="Technical capabilities" />
  <div class="capabilities-layout">
    <h2 id="capabilities-title" data-reveal>Unity systems.<br /><em>XR interaction.</em></h2>
    <ul>
      {capabilities.map((capability, index) => (
        <li data-reveal style={`--item-index: ${index}`}>
          <span>{String(index + 1).padStart(2, '0')}</span>
          {capability}
        </li>
      ))}
    </ul>
  </div>
</section>
