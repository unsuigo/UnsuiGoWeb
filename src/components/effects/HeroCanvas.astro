<div class="form-field" aria-hidden="true" data-form-field>
  <canvas></canvas>
  <div class="form-field__fallback">
    <span></span><span></span><span></span>
  </div>
  <div class="form-field__caption">
    <span>Play</span>
    <span>Form</span>
  </div>
</div>

<script>
  const container = document.querySelector<HTMLElement>('[data-form-field]');
  const canvas = container?.querySelector('canvas');
  const context = canvas?.getContext('2d');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (container && canvas && context) {
    let width = 0;
    let height = 0;
    let frame = 0;
    let time = 0;
    let isVisible = true;
    const pointer = { x: 0, y: 0, tx: 0, ty: 0 };

    const resize = () => {
      const rect = container.getBoundingClientRect();
      const ratio = Math.min(window.devicePixelRatio || 1, 1.75);
      width = rect.width;
      height = rect.height;
      canvas.width = Math.round(width * ratio);
      canvas.height = Math.round(height * ratio);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;
      context.setTransform(ratio, 0, 0, ratio, 0, 0);
    };

    const project = (u: number, v: number, t: number) => {
      const pulse = 1 + Math.sin(u * 3 + t * 0.8) * 0.08;
      const major = Math.min(width, height) * 0.255;
      const minor = Math.min(width, height) * 0.092 * pulse;
      const twist = u * 0.5 + Math.sin(t * 0.45) * 0.18;
      let x = (major + minor * Math.cos(v)) * Math.cos(u);
      let y = (major + minor * Math.cos(v)) * Math.sin(u);
      let z = minor * Math.sin(v);

      const tilt = -0.72 + pointer.y * 0.2;
      const yaw = t * 0.15 + pointer.x * 0.28;
      const y1 = y * Math.cos(tilt) - z * Math.sin(tilt);
      const z1 = y * Math.sin(tilt) + z * Math.cos(tilt);
      const x2 = x * Math.cos(yaw + twist * 0.06) + z1 * Math.sin(yaw + twist * 0.06);
      const z2 = -x * Math.sin(yaw + twist * 0.06) + z1 * Math.cos(yaw + twist * 0.06);
      const depth = 1 + z2 / (major * 3.2);

      return {
        x: width * 0.5 + x2 * depth,
        y: height * 0.49 + y1 * depth,
        z: z2,
      };
    };

    const draw = () => {
      pointer.x += (pointer.tx - pointer.x) * 0.045;
      pointer.y += (pointer.ty - pointer.y) * 0.045;
      if (!reduceMotion) time += 0.012;

      context.clearRect(0, 0, width, height);
      const lines: { points: ReturnType<typeof project>[]; depth: number }[] = [];

      for (let ring = 0; ring < 31; ring += 1) {
        const v = (ring / 30) * Math.PI * 2;
        const points = [];
        let depth = 0;
        for (let segment = 0; segment <= 96; segment += 1) {
          const u = (segment / 96) * Math.PI * 2;
          const point = project(u, v + Math.sin(u * 2 + time) * 0.18, time);
          points.push(point);
          depth += point.z;
        }
        lines.push({ points, depth: depth / points.length });
      }

      lines.sort((a, b) => a.depth - b.depth);
      lines.forEach((line, index) => {
        const normalized = index / lines.length;
        context.beginPath();
        line.points.forEach((point, pointIndex) => {
          if (pointIndex === 0) context.moveTo(point.x, point.y);
          else context.lineTo(point.x, point.y);
        });
        context.strokeStyle = normalized > 0.54
          ? `rgba(255, 81, 28, ${0.36 + normalized * 0.56})`
          : `rgba(241, 239, 232, ${0.08 + normalized * 0.25})`;
        context.lineWidth = normalized > 0.72 ? 1.35 : 0.75;
        context.stroke();
      });

      if (!reduceMotion && isVisible) frame = window.requestAnimationFrame(draw);
    };

    container.addEventListener('pointermove', (event) => {
      const rect = container.getBoundingClientRect();
      pointer.tx = ((event.clientX - rect.left) / rect.width - 0.5) * 2;
      pointer.ty = ((event.clientY - rect.top) / rect.height - 0.5) * 2;
    });
    container.addEventListener('pointerleave', () => {
      pointer.tx = 0;
      pointer.ty = 0;
    });

    const observer = new ResizeObserver(() => {
      resize();
      if (reduceMotion) draw();
    });
    const visibilityObserver = new IntersectionObserver(([entry]) => {
      const wasVisible = isVisible;
      isVisible = entry.isIntersecting;
      if (isVisible && !wasVisible && !reduceMotion) {
        frame = window.requestAnimationFrame(draw);
      } else if (!isVisible) {
        window.cancelAnimationFrame(frame);
      }
    });
    observer.observe(container);
    visibilityObserver.observe(container);
    resize();
    draw();

    document.addEventListener('astro:before-swap', () => {
      observer.disconnect();
      visibilityObserver.disconnect();
      window.cancelAnimationFrame(frame);
    }, { once: true });
  }
</script>
