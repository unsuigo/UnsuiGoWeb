---
import { navigation, siteSettings } from '@/data/site';
---

<header class="site-header" data-header>
  <a class="site-header__brand" href={`${import.meta.env.BASE_URL}`} aria-label="PLAYFORM home">
    <span>{siteSettings.name}</span>
    <span class="site-header__descriptor">{siteSettings.descriptor}</span>
  </a>

  <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation">
    <span>Menu</span>
    <span class="menu-toggle__mark" aria-hidden="true"></span>
  </button>

  <nav class="site-nav" id="primary-navigation" aria-label="Primary navigation">
    <ul>
      {navigation.map((item, index) => (
        <li>
          <a href={`${import.meta.env.BASE_URL}${item.href.replace(/^\//, '')}`}>
            <span class="site-nav__index">0{index + 1}</span>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  const button = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  const nav = header?.querySelector<HTMLElement>('.site-nav');

  const closeMenu = () => {
    button?.setAttribute('aria-expanded', 'false');
    header?.classList.remove('is-open');
  };

  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    header?.classList.toggle('is-open', !open);
  });

  nav?.addEventListener('click', (event) => {
    if ((event.target as HTMLElement).closest('a')) closeMenu();
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') closeMenu();
  });
</script>
