---
import { footer, navigation, siteSettings } from '@/data/site';
---

<footer class="site-footer">
  <a class="site-footer__brand" href={import.meta.env.BASE_URL}>PLAYFORM<span>®</span></a>
  <div class="site-footer__columns">
    <div>
      <p class="site-footer__label">Navigate</p>
      {navigation.map((item) => <a href={`${import.meta.env.BASE_URL}${item.href.replace(/^\//, '')}`}>{item.label}</a>)}
    </div>
    <div>
      <p class="site-footer__label">Elsewhere</p>
      {siteSettings.social.map((item) => <a href={item.href} rel="noreferrer">{item.label}</a>)}
    </div>
    <div>
      <p class="site-footer__label">Say hello</p>
      <a href={`mailto:${siteSettings.email}`}>{siteSettings.email}</a>
    </div>
  </div>
  <div class="site-footer__base">
    <p>{footer.legal}</p>
    <p>{footer.note}</p>
    <a href="#main-content">Back to top ↑</a>
  </div>
</footer>
