---
import { footer, navigation, siteSettings } from '@/data/site';
---

<footer class="site-footer">
  <a class="site-footer__brand" href={import.meta.env.BASE_URL}>UnsuiGo<span>®</span></a>
  <div class="site-footer__columns">
    <div>
      <p class="site-footer__label">Navigate</p>
      {navigation.map((item) => <a href={`${import.meta.env.BASE_URL}${item.href.replace(/^\//, '')}`}>{item.label}</a>)}
    </div>
    <div>
      <p class="site-footer__label">Availability</p>
      <p>Freelance</p>
      <p>Contract</p>
      <p>Remote</p>
    </div>
    <div>
      <p class="site-footer__label">Contact</p>
      {siteSettings.contactEmail ? <a href={`mailto:${siteSettings.contactEmail}`}>{siteSettings.contactEmail}</a> : <p>{siteSettings.contactLabel}</p>}
      <p>{siteSettings.location}</p>
    </div>
  </div>
  <div class="site-footer__base">
    <p>{footer.legal}</p>
    <p>{footer.note}</p>
    <a href="#main-content">Back to top ↑</a>
  </div>
</footer>
